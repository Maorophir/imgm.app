# ==============================================================================
# IMGM AI Service Configuration (Example Template)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model & Embeddings Providers
# ------------------------------------------------------------------------------
# Choose which model provider to use: "ollama" (local) or "gemini" (cloud)
LLM_PROVIDER=ollama

# Embeddings for RAG: "ollama" (nomic-embed-text) or "gemini"
# Configured separately from LLM_PROVIDER: stored vectors only match questions from the same model
EMBEDDINGS_PROVIDER=ollama

# Default model when using Ollama (defaults to gemma4:e4b if unset)
OLLAMA_MODEL=gemma4:e4b

# ------------------------------------------------------------------------------
# 2. AI & Search API Keys
# ------------------------------------------------------------------------------
# Google Gemini API Keys
# Gemini runs free/dev key first, paid key only as fallback (models/llm.py)
# GEMINI_DEV_API_KEY also works for local dev
GEMINI_FREE_API_KEY=your-free-project-key
GEMINI_PAID_API_KEY=your-paid-project-key

# Vertex AI (Google Cloud's Gemini, billed to the project's billing account and credits)
# Locally: gcloud auth application-default login
VERTEX_PROJECT=
VERTEX_LOCATION=global

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Tavily Web Search API Key
TAVILY_API_KEY=your_tavily_search_api_key_here

# ------------------------------------------------------------------------------
# 3. Database Connections
# ------------------------------------------------------------------------------
# PostgreSQL database connection URL (matches imgm-server main DB)
DATABASE_URL=postgresql://imgm_user:imgm_password@localhost:5432/imgm_db

# Dedicated pgvector database connection URL for AI embeddings & chat memory
VECTOR_DATABASE_URL=postgresql://imgm_user:imgm_password@localhost:5432/imgm_ai

# ------------------------------------------------------------------------------
# 4. LangSmith Tracing & Observability (Optional)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="Game Recommendation Agent"

# ------------------------------------------------------------------------------
# 5. Service Integration & Security
# ------------------------------------------------------------------------------
# Public URL of the backend API (imgm-server)
IMGM_API_URL=http://localhost:5000

# Shared secret: only Express (which sends it as X-Internal-Key) may call this service
# Leave empty locally; REQUIRED in production. Generate: openssl rand -hex 32
INTERNAL_API_KEY=

# ------------------------------------------------------------------------------
# 6. Local Development & Testing
# ------------------------------------------------------------------------------
# Test user ID for local CLI invocations (python -m imgm_ai)
TEST_USER_ID=
