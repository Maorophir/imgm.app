# ==============================================================================
# IMGM AI Service Configuration (Example Template)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider
# ------------------------------------------------------------------------------
# Options: "ollama" (local) or "gemini" (cloud)
LLM_PROVIDER=ollama
# Embeddings for RAG: "ollama" (nomic-embed-text) or "gemini". Configured separately
# from LLM_PROVIDER on purpose: stored vectors only match questions from the same model.
EMBEDDINGS_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 2. AI & Search API Keys
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_search_api_key_here

# ------------------------------------------------------------------------------
# 3. Database Connection
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://imgm_user:imgm_password@localhost:5432/imgm_db

# ------------------------------------------------------------------------------
# 4. LangSmith Tracing & Observability (Optional)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="Game Recommendation Agent"

# ------------------------------------------------------------------------------
# 5. The web service (imgm_ai.server)
# ------------------------------------------------------------------------------
# Shared secret: only Express (which sends it as X-Internal-Key) may call this service.
# Leave empty locally; REQUIRED in production. Generate: openssl rand -hex 32
INTERNAL_API_KEY=
