# Copy to .env and fill in. Never commit the real .env.

PORT=5000
DATABASE_URL=

# Better Auth
# Secret: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the API, e.g. http://localhost:5000 (dev) or https://imgm.app (prod)
BETTER_AUTH_URL=

# Comma-separated browser origins allowed to call the API (CORS + auth)
# e.g. http://localhost:5173 (dev) or https://imgm.app,https://www.imgm.app (prod)
CLIENT_ORIGINS=

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IGDB via Twitch (dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
