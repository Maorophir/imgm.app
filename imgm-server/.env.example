# ==============================================================================
# IMGM Server Configuration (Example Template)
# ==============================================================================
# Copy to .env and fill in. Never commit the real .env to source control.

# ------------------------------------------------------------------------------
# 1. Server & Network
# ------------------------------------------------------------------------------
PORT=5000

# Comma-separated browser origins allowed to call the API (CORS + auth)
# Local: http://localhost:5173 | Prod: https://imgm.app,https://www.imgm.app
CLIENT_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# Local PostgreSQL database connection URL
DATABASE_URL=postgresql://imgm_user:imgm_password@localhost:5432/imgm_db?schema=public

# Cloud / Neon PostgreSQL (Production reference):
# DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-xxxx.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL_POOLED=postgresql://neondb_owner:npg_xxxx@ep-xxxx-pooler.neon.tech/neondb?sslmode=require&channel_binding=require

# ------------------------------------------------------------------------------
# 3. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Secret: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Public URL of the API (http://localhost:5000 in dev, https://imgm.app in prod)
BETTER_AUTH_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 4. OAuth Providers
# ------------------------------------------------------------------------------
# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. Twitch & IGDB API
# ------------------------------------------------------------------------------
# Twitch credentials for IGDB API access (dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6. AI Service Integration (imgm-ai)
# ------------------------------------------------------------------------------
# URL of the AI service behind Game Guide (defaults to http://localhost:8000)
AI_SERVICE_URL=http://localhost:8000

# Shared secret with imgm-ai (matches INTERNAL_API_KEY in imgm-ai/.env; empty for local dev)
INTERNAL_API_KEY=

# Optional: direct Gemini API key if using server-side fallback
# GEMINI_API_KEY=
# AI_PROVIDER=gemini
# AI_MODEL=

# ------------------------------------------------------------------------------
# 7. Email Service (Resend)
# ------------------------------------------------------------------------------
# Emails (password reset / notifications) via Resend. Empty = logs to console in dev.
RESEND_API_KEY=
EMAIL_FROM=IMGM <no-reply@imgm.app>
# FEEDBACK_EMAIL=

# ------------------------------------------------------------------------------
# 8. Feature Flags & Optional Config
# ------------------------------------------------------------------------------
# ID of a review to pin on the home page (empty = best recent review)
# HOME_PINNED_REVIEW_ID=

# Play Next AI recommender toggle: 'on' to force enable, or beta user whitelist
# PLAY_NEXT=
# PLAY_NEXT_BETA_USERS=
