# Copy to .env and fill in. Never commit the real .env.

PORT=5000
DATABASE_URL=

# Better Auth
# Secret: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the API, e.g. http://localhost:5000 (dev) or https://imgm.app (prod)
BETTER_AUTH_URL=

# Comma-separated browser origins allowed to call the API (CORS + auth)
# e.g. http://localhost:5173 (dev) or https://imgm.app,https://www.imgm.app (prod)
CLIENT_ORIGINS=

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IGDB via Twitch (dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# AI (services/ai/) — optional: without a key, AI features are simply off
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides: AI_PROVIDER defaults to gemini, AI_MODEL to the provider's default
AI_PROVIDER=
AI_MODEL=

# The AI service (imgm-ai) behind the Game Guide, and the shared secret it expects
# (the same INTERNAL_API_KEY as in imgm-ai/.env; empty = no check, for local dev only)
AI_SERVICE_URL=
INTERNAL_API_KEY=

# Emails (password reset) via Resend's HTTP API. Empty = emails are printed to the
# server log instead of sent (local development).
RESEND_API_KEY=
EMAIL_FROM=IMGM <no-reply@imgm.app>
