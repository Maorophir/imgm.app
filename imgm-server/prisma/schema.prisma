// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Better Auth Core Tables
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]

  // Public gamer tag (the real `name` from Google/sign-up is never shown publicly).
  // `username` = lowercase, for uniqueness; `displayUsername` = the user's capitalisation.
  username          String?   @unique
  displayUsername   String?
  usernameChangedAt DateTime? // for the 30-day change limit
  // Profile picture (checked by SafeSearch; the image is in UserAvatar). Also its
  // cache-buster: the picture's address carries this time, so a new one shows at once
  avatarUpdatedAt   DateTime?
  avatar            UserAvatar?
  accounts      Account[]
  
  // Custom IMGM relations
  reviews       Review[]
  playNextChats PlayNextChat[]
  reviewVotes   ReviewVote[]
  gotwVotes     GotwVote[]
  gotwNominations GotwNomination[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  issuer                String?
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// IMGM Domain Tables
// -----------------------------------------------------------------------------

model Game {
  id            Int      @id @default(autoincrement()) // Matching IGDB IDs
  title         String
  slug          String   @unique
  coverUrl      String?
  description   String?
  releaseDate   DateTime?
  developer     String?
  publisher     String?
  platforms     String[] // Natively supported by Postgres!
  genres        String[] // Natively supported by Postgres!
  artworks      String[] // Full hero image URLs (t_1080p)
  screenshots   String[] // In-game screenshot URLs (t_1080p) for the gallery
  videos        Json?    // [{ name, youtubeId }]

  reviews       Review[]
  aiSummary     GameAISummary?
  gotwCandidacies GotwCandidate[]
  gotwWins      GotwWeek[]  @relation("GotwWinner")
  gotwVotes     GotwVote[]
  gotwNominations GotwNomination[]

  // Reviews that compared another game to this one ("It's like ___ meets ___")
  comparedInA   Review[] @relation("ComparedA")
  comparedInB   Review[] @relation("ComparedB")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A review written through the "review quest". Only `rating` is required —
// every other field is one skippable quest screen (null / empty = skipped).
// Allowed values for the string fields live in src/lib/reviewOptions.js.
model Review {
  id               String   @id @default(cuid())

  // ① Rating (required)
  rating           Int      // 1-10

  // ② Your setup
  platform         String?
  hoursPlayed      Int?
  completionStatus String?  // playing | finished | completed_100 | dropped
  playStyle        String?  // solo | coop | online

  // ③ Vibe check (up to 3)
  vibes            String[]

  // ④ When did it get good?
  gotGoodAfter     String?  // never | many_hours | few_hours | instantly

  // ⑤ The checklist — each category is optional (keys: CHECKLIST in reviewOptions.js)
  graphics         String?
  gameplay         String?
  audio            String?
  story            String?
  difficulty       String?
  grind            String?
  gameLength       String?
  bugs             String?
  pcRequirements   String?
  worthPrice       String?
  replay           String?

  // ⑥ It's like ___ meets ___
  comparedAId      Int?
  comparedA        Game?    @relation("ComparedA", fields: [comparedAId], references: [id])
  comparedBId      Int?
  comparedB        Game?    @relation("ComparedB", fields: [comparedBId], references: [id])

  // ⑦ Pros & cons
  pros             String[]
  cons             String[]

  // ⑧ Best / worst moment
  bestMoment       String?
  worstMoment      String?
  hasSpoilers      Boolean  @default(false)

  // ⑨ Final words (optional — quick reviews may have none)
  reviewText       String?

  // Awarded by the server when the review is saved
  badges           String[]
  xp               Int      @default(0) // XP this review earned; a player's XP = the sum
  // "Was this review helpful?" (votes in ReviewVote; these are kept in step with them)
  helpfulCount     Int      @default(0)
  unhelpfulCount   Int      @default(0)
  helpfulScore     Float    @default(0) // how surely it's helpful (Wilson score), for "Most helpful"
  helpfulXp        Int      @default(0) // XP the author earned from helpful votes (capped)
  votes            ReviewVote[]

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameId           Int
  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  analysis         ReviewAnalysis?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // One review per person per game — reviewing again edits it
  @@unique([userId, gameId])
}

model ReviewAnalysis {
  id               String   @id @default(cuid())
  sentiment        String   // Positive, Mixed, Negative
  rawLlmResponse   String   // JSON string
  modelUsed        String
  
  reviewId         String   @unique
  review           Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  analyzedAt       DateTime @default(now())
}

model GameAISummary {
  id                     String   @id @default(cuid())
  overallSentiment       String
  summaryText            String
  reviewCountAtGen       Int
  // What players praise, criticize or disagree on: [{ label, sentiment, support }]
  aspects                Json     @default("[]")
  
  gameId                 Int      @unique
  game                   Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  generatedAt            DateTime @default(now())
}

// -----------------------------------------------------------------------------
// Play Next chat history (what the page shows; the AI service keeps its own memory
// of each chat under the same ids). 20 per player, deleted after 30 days.
// -----------------------------------------------------------------------------

model PlayNextChat {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id        String   // the page's chat id; unique per player, so ids can't collide across players
  title     String   // the chat's first question
  turns     Json     // the turns as the page shows them (question, steps, answer, cards)
  prefs     Json     @default("{}") // this chat's "Tune it" answers, restored when it's reopened
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, id])
  @@index([userId, updatedAt])
}

// One player's vote on one review: helpful or not. Changing it updates the row.
model ReviewVote {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  helpful   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, reviewId])
  @@index([reviewId])
}

// -----------------------------------------------------------------------------
// Game of the Week: players vote Sunday to Saturday (Israel time) on a ballot of
// candidates; the winner is next week's Game of the Week (lib/gotw.js).
// -----------------------------------------------------------------------------

model GotwWeek {
  id         String          @id // the Sunday the voting week starts, "2026-10-11"
  startsAt   DateTime        // Sunday 00:00 in Israel
  endsAt     DateTime        // the next Sunday 00:00 (voting closes)
  winnerId   Int?
  winner     Game?           @relation("GotwWinner", fields: [winnerId], references: [id])
  closedAt   DateTime?       // set when the votes were counted
  candidates GotwCandidate[]
  votes      GotwVote[]
  nominations GotwNomination[]
  createdAt  DateTime        @default(now())
}

// One game on a week's ballot, and why it's there (its slot: hot, favorite…)
model GotwCandidate {
  weekId String
  week   GotwWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  gameId Int
  game   Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  slot   String
  order  Int      // its place on the ballot

  @@id([weekId, gameId])
}

// One player's vote in one week (changeable until the week closes)
model GotwVote {
  weekId    String
  week      GotwWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([weekId, userId])
  @@index([weekId, gameId])
}

// A player's nomination during a week: the most-nominated game gets next week's
// "Player pick" slot on the ballot. One per player per week (changeable).
model GotwNomination {
  weekId    String
  week      GotwWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([weekId, userId])
  @@index([weekId, gameId])
}

// A player's profile picture: a small image (256px) that passed the SafeSearch check
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mime      String
  updatedAt DateTime @updatedAt
}
